rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             (!('titleOrProfession' in data) || data.titleOrProfession == null || (data.titleOrProfession is string && data.titleOrProfession.size() <= 150)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             (!('summary' in data) || data.summary == null || (data.summary is string && data.summary.size() <= 2000)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCertificate(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.organization is string && data.organization.size() > 0 && data.organization.size() <= 200 &&
             data.issueDate is string && data.issueDate.size() > 0 && data.issueDate.size() <= 50 &&
             (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 50)) &&
             (!('expiryDate' in data) || data.expiryDate == null || (data.expiryDate is string && data.expiryDate.size() <= 50)) &&
             (!('credentialId' in data) || data.credentialId == null || (data.credentialId is string && data.credentialId.size() <= 100)) &&
             (!('credentialUrl' in data) || data.credentialUrl == null || (data.credentialUrl is string && data.credentialUrl.size() <= 500)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 3000)) &&
             (!('gradeOrScore' in data) || data.gradeOrScore == null || (data.gradeOrScore is string && data.gradeOrScore.size() <= 100)) &&
             (!('attachmentName' in data) || data.attachmentName == null || (data.attachmentName is string && data.attachmentName.size() <= 250)) &&
             (!('attachmentType' in data) || data.attachmentType == null || (data.attachmentType is string && data.attachmentType.size() <= 100)) &&
             (!('attachmentPath' in data) || data.attachmentPath == null || (data.attachmentPath is string && data.attachmentPath.size() <= 500)) &&
             (!('attachmentSize' in data) || data.attachmentSize == null || data.attachmentSize is int || data.attachmentSize is float) &&
             (!('skills' in data) || (data.skills is list && data.skills.size() <= 30 && (data.skills.size() == 0 || data.skills[0] is string))) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'fullName']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       isValidUserProfile(incoming());

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /certificates/{certificateId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'organization', 'issueDate']) &&
                         isValidCertificate(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         isValidCertificate(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
